# Plantilla de firma de release.
#
# CÓMO USARLA:
# 1. Copia este fichero como `android/keystore.properties` (está en .gitignore:
#    JAMÁS se sube a git).
# 2. Copia tu .keystore dentro de `android/` (también ignorado por git).
# 3. Rellena los 4 valores. Si no recuerdas el alias, pídemelo y lo leo del
#    keystore con keytool.
#
# Sin este fichero, `gradlew bundleRelease` genera un AAB SIN FIRMAR
# (app-release-unsigned.aab) que Play Store rechaza.

storeFile=litrogasolina.keystore
storePassword=CONTRASENA_DEL_KEYSTORE
keyAlias=MISMO_ALIAS_DE_MI_APP_ANTIGUA
keyPassword=CONTRASENA_DE_LA_CLAVE
