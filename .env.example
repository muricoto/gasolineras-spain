# URL base del API REST oficial de carburantes (MITECO / MITUR)
MITECO_API_URL=https://sedeaplicaciones.minetur.gob.es/ServiciosRESTCarburantes/PreciosCarburantes
# Puerto del backend/proxy (sirve /api/* y el frontend en producción)
PORT=3001
# Tiempo de vida de la caché del proxy en milisegundos (por defecto 15 min)
CACHE_TTL_MS=900000
# Solo para la APK de Capacitor: URL pública del backend (sin barra final).
# En web se deja vacío para usar el relativo /api/stations.
# Ej: VITE_API_URL=https://api.tudominio.es
VITE_API_URL=
